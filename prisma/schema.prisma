generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id             String          @id @default(cuid())
  name           String          @unique
  color          String
  subjectLabel   String          @default("Tag")
  tasks          Task[]
  dailyTemplates DailyTemplate[]
  createdAt      DateTime        @default(now())
}

model DailyTemplate {
  id            String   @id @default(cuid())
  title         String
  subject       String?
  startTime     String?
  endTime       String?
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subtaskTitles String[] @default([])
  instances     Task[]
  createdAt     DateTime @default(now())
}

model Task {
  id              String         @id @default(cuid())
  title           String
  subject         String?
  due             DateTime?
  startTime       String?
  endTime         String?
  completed       Boolean        @default(false)
  completedAt     DateTime?
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  dailyTemplateId String?
  dailyTemplate   DailyTemplate? @relation(fields: [dailyTemplateId], references: [id], onDelete: Cascade)
  subtasks        Subtask[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([categoryId])
  @@index([due])
  @@index([completed])
  @@index([dailyTemplateId])
}

model Subtask {
  id     String  @id @default(cuid())
  title  String
  done   Boolean @default(false)
  order  Int     @default(0)
  taskId String
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}
